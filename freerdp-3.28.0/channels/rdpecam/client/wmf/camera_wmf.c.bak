#define TAG CHANNELS_TAG("rdpecam-wmf.client")

#define CAM_WMF_FRAMERATE_NUMERATOR_DEFAULT 30
#define CAM_WMF_FRAMERATE_DENOMINATOR_DEFAULT 1

/* Reference counter for MFStartup/MFShutdown */
static LONG g_mfRefCount = 0;
static CRITICAL_SECTION g_mfLock;
static BOOL g_mfLockInit = FALSE;

/* Local static GUID constants for format conversion.
 * We avoid using the MFVideoFormat_* macros directly to stay compatible
 * with MSVC C mode compilation (REFGUID / IsEqualGUID pitfalls). */
static const GUID s_cam_MFVideoFormat_NV12 = {
	0x3231564e, 0x0000, 0x0010, { 0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71 }
};
static const GUID s_cam_MFVideoFormat_YUY2 = {
	0x32595559, 0x0000, 0x0010, { 0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71 }
};
static const GUID s_cam_MFVideoFormat_I420 = {
	0x30323449, 0x0000, 0x0010, { 0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71 }
};
static const GUID s_cam_MFVideoFormat_MJPG = {
	0x47504a4d, 0x0000, 0x0010, { 0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71 }
};
static const GUID s_cam_MFVideoFormat_H264 = {
	0x34363248, 0x0000, 0x0010, { 0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71 }
};
static const GUID s_cam_MFVideoFormat_RGB24 = {
	0x00000018, 0x0000, 0x0010, { 0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71 }
};
static const GUID s_cam_MFVideoFormat_RGB32 = {
	0x00000020, 0x0000, 0x0010, { 0x80, 0x00, 0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71 }
};
static const GUID s_cam_MFMediaType_Video = {
	0x73646976, 0x0000, 0x0010, { 0x80, 0x00, 0x00, 0xAA, 0x00, 0x38, 0x9B, 0x71 }
};
static const GUID s_cam_MF_MT_MAJOR_TYPE = {
	0x48eba18e, 0xf8c9, 0x4687, { 0xbf, 0x11, 0x0a, 0x74, 0xc9, 0xf9, 0x6a, 0x8f }
};
static const GUID s_cam_MF_MT_SUBTYPE = {
	0xf7e34c9a, 0x42e8, 0x4714, { 0xb7, 0x4b, 0xcb, 0x29, 0xd7, 0x2c, 0x35, 0xe5 }
};
static const GUID s_cam_MF_MT_FRAME_SIZE = {
	0x1652c33d, 0xd6b2, 0x4012, { 0xb8, 0x34, 0x72, 0x03, 0x08, 0x49, 0xa3, 0x7d }
};
static const GUID s_cam_MF_MT_FRAME_RATE = {
	0xc459a2e8, 0x3cb2, 0x440e, { 0xb6, 0xf9, 0x96, 0x09, 0xd4, 0x6c, 0x3b, 0x74 }
};

typedef struct
{
	ICamHal iHal;

	wHashTable* streams; /* Index: deviceId, Value: CamWmfStream */
	wArrayList* activates; /* IMFActivate* for each enumerated device */

} CamWmfHal;

static CamWmfStream* cam_wmf_stream_create(const char* deviceId, size_t streamIndex);
static void cam_wmf_stream_free(void* obj);
static CAM_ERROR_CODE cam_wmf_stream_stop(CamWmfStream* stream);
static IMFActivate* cam_wmf_find_activate(CamWmfHal* hal, const char* deviceId);
static IMFSourceReader* cam_wmf_open_device(CamWmfHal* hal, const char* deviceId,
                                            IMFMediaSource** outMediaSource);
static void cam_wmf_close_device(IMFSourceReader** pSourceReader,
                                 IMFMediaSource** pMediaSource);
static IMFActivate* cam_wmf_refresh_activate_for_device(CamWmfHal* hal, const char* deviceId);

/* =====================================================================
 * Media Foundation initialization helpers (ref-counted)
 * ===================================================================== */

static HRESULT cam_wmf_global_init(void)
{
	HRESULT hr;

	if (!g_mfLockInit)
	{
		if (!InitializeCriticalSectionEx(&g_mfLock, 0, 0))
			return E_OUTOFMEMORY;
		g_mfLockInit = TRUE;
	}

	EnterCriticalSection(&g_mfLock);

	if (g_mfRefCount == 0)
	{
		hr = MFStartup(MF_VERSION, MFSTARTUP_NOSOCKET);
		if (FAILED(hr))
		{
			WLog_ERR(TAG, "MFStartup failed: hr=0x%08" PRIX32, (UINT32)hr);
			LeaveCriticalSection(&g_mfLock);
			return hr;
		}
	}

	g_mfRefCount++;
	LeaveCriticalSection(&g_mfLock);
	return S_OK;
}

static HRESULT cam_wmf_global_shutdown(void)
{
	HRESULT hr = S_OK;

	if (!g_mfLockInit)
		return S_OK;

	EnterCriticalSection(&g_mfLock);

	if (g_mfRefCount > 0)
	{
		g_mfRefCount--;
		if (g_mfRefCount == 0)
			hr = MFShutdown();
	}

	LeaveCriticalSection(&g_mfLock);
	return hr;
}

/* =====================================================================
 * Format conversion helpers
 * ===================================================================== */

static CAM_MEDIA_FORMAT mfSubtypeToEcam(REFGUID subtype)
{
	if (memcmp(subtype, &s_cam_MFVideoFormat_NV12, sizeof(GUID)) == 0)
		return CAM_MEDIA_FORMAT_NV12;
	if (memcmp(subtype, &s_cam_MFVideoFormat_YUY2, sizeof(GUID)) == 0)
		return CAM_MEDIA_FORMAT_YUY2;
	if (memcmp(subtype, &s_cam_MFVideoFormat_I420, sizeof(GUID)) == 0)
		return CAM_MEDIA_FORMAT_I420;
	if (memcmp(subtype, &s_cam_MFVideoFormat_MJPG, sizeof(GUID)) == 0)
		return CAM_MEDIA_FORMAT_MJPG;
	if (memcmp(subtype, &s_cam_MFVideoFormat_H264, sizeof(GUID)) == 0)
		return CAM_MEDIA_FORMAT_H264;
	if (memcmp(subtype, &s_cam_MFVideoFormat_RGB24, sizeof(GUID)) == 0)
		return CAM_MEDIA_FORMAT_RGB24;
	if (memcmp(subtype, &s_cam_MFVideoFormat_RGB32, sizeof(GUID)) == 0)
		return CAM_MEDIA_FORMAT_RGB32;
	return CAM_MEDIA_FORMAT_INVALID;
}

static const GUID* ecamToMfSubtype(CAM_MEDIA_FORMAT ecamFormat)
{
	switch (ecamFormat)
	{
		case CAM_MEDIA_FORMAT_NV12:
			return &s_cam_MFVideoFormat_NV12;
		case CAM_MEDIA_FORMAT_YUY2:
			return &s_cam_MFVideoFormat_YUY2;
		case CAM_MEDIA_FORMAT_I420:
			return &s_cam_MFVideoFormat_I420;
		case CAM_MEDIA_FORMAT_MJPG:
			return &s_cam_MFVideoFormat_MJPG;
		case CAM_MEDIA_FORMAT_H264:
			return &s_cam_MFVideoFormat_H264;
		case CAM_MEDIA_FORMAT_RGB24:
			return &s_cam_MFVideoFormat_RGB24;
		case CAM_MEDIA_FORMAT_RGB32:
			return &s_cam_MFVideoFormat_RGB32;
		default:
			return nullptr;
	}
}

/* =====================================================================
 * CamWmfStream lifecycle
 * ===================================================================== */

CamWmfStream* cam_wmf_stream_create(const char* deviceId, size_t streamIndex)
{
	WINPR_UNUSED(deviceId);
	CamWmfStream* stream = (CamWmfStream*)calloc(1, sizeof(CamWmfStream));

	if (!stream)
	{
		WLog_ERR(TAG, "calloc failed!");
		return nullptr;
	}

	stream->streamIndex = streamIndex;
	stream->streaming = FALSE;
	stream->mediaSource = nullptr;
	stream->sourceReader = nullptr;
	stream->captureThread = nullptr;

	if (!InitializeCriticalSectionEx(&stream->lock, 0, 0))
	{
		WLog_ERR(TAG, "InitializeCriticalSectionEx failed!");
		free(stream);
		return nullptr;
	}

	return stream;
}

static void cam_wmf_stream_free(void* obj)
{
	CamWmfStream* stream = (CamWmfStream*)obj;
	if (!stream)
		return;

	cam_wmf_stream_stop(stream);

	if (stream->sourceReader)
	{
		stream->sourceReader->lpVtbl->Release(stream->sourceReader);
		stream->sourceReader = nullptr;
	}

	if (stream->mediaSource)
	{
		stream->mediaSource->lpVtbl->Shutdown(stream->mediaSource);
		stream->mediaSource->lpVtbl->Release(stream->mediaSource);
		stream->mediaSource = nullptr;
	}

	if (stream->nativeMediaType)
	{
		stream->nativeMediaType->lpVtbl->Release(stream->nativeMediaType);
		stream->nativeMediaType = nullptr;
	}

	DeleteCriticalSection(&stream->lock);
	free(stream);
}

/* =====================================================================
 * MF H.264 Encoder (transport-layer compression)
 * ===================================================================== */

/* CLSID_CMSH264EncoderMFT */
static const GUID CLSID_MF_H264Encoder = { 0x6CA50344, 0x051A, 0x4DED,
	{ 0x97, 0x79, 0xA4, 0x33, 0x05, 0x16, 0x5E, 0x35 } };

static BOOL cam_wmf_h264_encoder_init(CamWmfStream* stream)
{
	HRESULT hr = CoCreateInstance(&CLSID_MF_H264Encoder, nullptr,
	                               CLSCTX_INPROC_SERVER, &IID_IMFTransform,
	                               (void**)&stream->h264Encoder);
	if (FAILED(hr))
	{
		WLog_ERR(TAG, "CoCreateInstance(H264Encoder) failed: hr=0x%08" PRIX32, (UINT32)hr);
		return FALSE;
	}

	/* Set output type first (MFT needs it before enumerating inputs) */
	IMFMediaType* pOutputType = nullptr;
	hr = MFCreateMediaType(&pOutputType);
	if (FAILED(hr)) goto fail;

	pOutputType->lpVtbl->SetGUID(pOutputType, &MF_MT_MAJOR_TYPE, &MFMediaType_Video);
	pOutputType->lpVtbl->SetGUID(pOutputType, &MF_MT_SUBTYPE, &MFVideoFormat_H264);
	pOutputType->lpVtbl->SetUINT64(pOutputType, &MF_MT_FRAME_SIZE,
	                                ((UINT64)stream->h264Width << 32) | stream->h264Height);
	pOutputType->lpVtbl->SetUINT64(pOutputType, &MF_MT_FRAME_RATE, ((UINT64)30 << 32) | 1);
	pOutputType->lpVtbl->SetUINT32(pOutputType, &MF_MT_MPEG2_PROFILE, 77);
	pOutputType->lpVtbl->SetUINT32(pOutputType, &MF_MT_AVG_BITRATE, 1250000);

	hr = stream->h264Encoder->lpVtbl->SetOutputType(stream->h264Encoder, 0, pOutputType, 0);
	pOutputType->lpVtbl->Release(pOutputType);
	if (FAILED(hr))
	{
		WLog_ERR(TAG, "H264 SetOutputType failed: hr=0x%08" PRIX32, (UINT32)hr);
		goto fail;
	}

	/* Get first input type from MFT (should be NV12) and set it */
	IMFMediaType* pInputType = nullptr;
	hr = stream->h264Encoder->lpVtbl->GetInputAvailableType(
	    stream->h264Encoder, 0, 0, &pInputType);
	if (FAILED(hr))
	{
		WLog_ERR(TAG, "H264 GetInputAvailableType failed: hr=0x%08" PRIX32, (UINT32)hr);
		goto fail;
	}

	pInputType->lpVtbl->SetUINT64(pInputType, &MF_MT_FRAME_SIZE,
	                               ((UINT64)stream->h264Width << 32) | stream->h264Height);

	hr = stream->h264Encoder->lpVtbl->SetInputType(stream->h264Encoder, 0, pInputType, 0);
	pInputType->lpVtbl->Release(pInputType);
	if (FAILED(hr))
	{
		WLog_ERR(TAG, "H264 SetInputType failed: hr=0x%08" PRIX32, (UINT32)hr);
		goto fail;
	}

	stream->h264FrameDuration = 10000000ULL / 30;
	stream->h264FrameCount = 0;
	WLog_INFO(TAG, "MF H.264 encoder initialized (%ux%u)", stream->h264Width, stream->h264Height);
	return TRUE;

fail:
	if (stream->h264Encoder)
	{
		stream->h264Encoder->lpVtbl->Release(stream->h264Encoder);
		stream->h264Encoder = nullptr;
	}
	return FALSE;
}

static void cam_wmf_h264_encoder_free(CamWmfStream* stream)
{
	if (stream->h264Encoder)
	{
		stream->h264Encoder->lpVtbl->Release(stream->h264Encoder);
		stream->h264Encoder = nullptr;
	}
	stream->h264FrameCount = 0;
}

static BOOL cam_wmf_h264_encode(CamWmfStream* stream, const BYTE* srcData,
                                size_t srcSize, BYTE** outData, UINT32* outSize)
{
	HRESULT hr;
	IMFTransform* pEncoder = stream->h264Encoder;

	IMFSample* pInSample = nullptr;
	IMFMediaBuffer* pInBuf = nullptr;
	hr = MFCreateSample(&pInSample);
	if (FAILED(hr)) return FALSE;

	hr = MFCreateMemoryBuffer((DWORD)srcSize, &pInBuf);
	if (FAILED(hr)) { pInSample->lpVtbl->Release(pInSample); return FALSE; }

	BYTE* pBuf = nullptr;
	hr = pInBuf->lpVtbl->Lock(pInBuf, &pBuf, nullptr, nullptr);
	if (SUCCEEDED(hr))
	{
		CopyMemory(pBuf, srcData, srcSize);
		pInBuf->lpVtbl->Unlock(pInBuf);
	}
	pInBuf->lpVtbl->SetCurrentLength(pInBuf, (DWORD)srcSize);
	pInSample->lpVtbl->AddBuffer(pInSample, pInBuf);
	pInBuf->lpVtbl->Release(pInBuf);

	pInSample->lpVtbl->SetSampleTime(pInSample, stream->h264FrameCount * stream->h264FrameDuration);
	pInSample->lpVtbl->SetSampleDuration(pInSample, stream->h264FrameDuration);

	hr = pEncoder->lpVtbl->ProcessInput(pEncoder, 0, pInSample, 0);
	pInSample->lpVtbl->Release(pInSample);
	if (FAILED(hr))
	{
		WLog_DBG(TAG, "H264 ProcessInput failed: hr=0x%08" PRIX32, (UINT32)hr);
		return FALSE;
	}

	MFT_OUTPUT_DATA_BUFFER outBuf = { 0 };
	IMFSample* pOutSample = nullptr;
	IMFMediaBuffer* pOutMfBuf = nullptr;

	hr = MFCreateSample(&pOutSample);
	if (FAILED(hr)) return FALSE;
	hr = MFCreateMemoryBuffer(256 * 1024, &pOutMfBuf);
	if (FAILED(hr)) { pOutSample->lpVtbl->Release(pOutSample); return FALSE; }

	pOutSample->lpVtbl->AddBuffer(pOutSample, pOutMfBuf);
	pOutMfBuf->lpVtbl->Release(pOutMfBuf);
	outBuf.pSample = pOutSample;

	DWORD status = 0;
	hr = pEncoder->lpVtbl->ProcessOutput(pEncoder, 0, 1, &outBuf, &status);
	if (FAILED(hr))
	{
		pOutSample->lpVtbl->Release(pOutSample);
		WLog_DBG(TAG, "H264 ProcessOutput failed: hr=0x%08" PRIX32, (UINT32)hr);
		return FALSE;
	}

	IMFMediaBuffer* pEncBuf = nullptr;
	hr = outBuf.pSample->lpVtbl->GetBufferByIndex(outBuf.pSample, 0, &pEncBuf);
	if (SUCCEEDED(hr))
	{
		BYTE* pEncData = nullptr;
		DWORD encLen = 0;
		hr = pEncBuf->lpVtbl->Lock(pEncBuf, &pEncData, nullptr, &encLen);
		if (SUCCEEDED(hr) && pEncData && encLen > 0)
		{
			*outData = (BYTE*)malloc(encLen);
			if (*outData)
			{
				CopyMemory(*outData, pEncData, encLen);
				*outSize = encLen;
				stream->h264FrameCount++;
			}
			pEncBuf->lpVtbl->Unlock(pEncBuf);
		}
		pEncBuf->lpVtbl->Release(pEncBuf);
	}

	pOutSample->lpVtbl->Release(pOutSample);
	return (*outSize > 0);
}

/* =====================================================================
 * Capture thread
 * ===================================================================== */

static DWORD WINAPI cam_wmf_capture_thread(LPVOID param)
{
	CamWmfStream* stream = (CamWmfStream*)param;
	WINPR_ASSERT(stream);

	HRESULT hr = CoInitializeEx(nullptr, COINIT_MULTITHREADED);
	if (FAILED(hr))
	{
		WLog_ERR(TAG, "CoInitializeEx failed: hr=0x%08" PRIX32, (UINT32)hr);
		return CHANNEL_RC_OK;
	}

	IMFSourceReader* reader = stream->sourceReader;

	while (stream->streaming)
	{
		DWORD streamIndex = MF_SOURCE_READER_FIRST_VIDEO_STREAM;
		DWORD flags = 0;
		LONGLONG timestamp = 0;
		IMFSample* sample = nullptr;

		hr = reader->lpVtbl->ReadSample(reader, streamIndex, 0, NULL, &flags, &timestamp, &sample);

		if (!stream->streaming)
			break;

		if (FAILED(hr))
		{
			WLog_DBG(TAG, "ReadSample failed: hr=0x%08" PRIX32 ", retrying", (UINT32)hr);
			Sleep(100);
			continue;
		}

		if (flags & MF_SOURCE_READERF_ERROR)
		{
			WLog_ERR(TAG, "Source reader error in stream");
			break;
		}

		if (flags & MF_SOURCE_READERF_ENDOFSTREAM)
		{
			WLog_DBG(TAG, "End of stream");
			break;
		}

		if (sample)
		{
			EnterCriticalSection(&stream->lock);

			if (stream->streaming && stream->sampleCallback)
			{
				IMFMediaBuffer* buf = nullptr;
				hr = sample->lpVtbl->GetBufferByIndex(sample, 0, &buf);

				if (SUCCEEDED(hr) && buf)
				{
					BYTE* data = nullptr;
					DWORD maxLen = 0, curLen = 0;
					hr = buf->lpVtbl->Lock(buf, &data, &maxLen, &curLen);

					if (SUCCEEDED(hr) && data && curLen > 0)
					{
						stream->sampleCallback(stream->dev, stream->streamIndex, data, curLen);
						buf->lpVtbl->Unlock(buf);
					}

					buf->lpVtbl->Release(buf);
				}
			}

			LeaveCriticalSection(&stream->lock);

			sample->lpVtbl->Release(sample);
		}
	}

	CoUninitialize();
	return CHANNEL_RC_OK;
}

/* =====================================================================
 * ICamHal interface implementation
 * ===================================================================== */

static UINT cam_wmf_enumerate(ICamHal* ihal, ICamHalEnumCallback callback, CameraPlugin* ecam,
                              GENERIC_CHANNEL_CALLBACK* hchannel)
{
	CamWmfHal* hal = (CamWmfHal*)ihal;
	UINT count = 0;
	HRESULT hr;

	IMFAttributes* pAttributes = nullptr;
	hr = MFCreateAttributes(&pAttributes, 1);
	if (FAILED(hr))
	{
		WLog_ERR(TAG, "MFCreateAttributes failed: hr=0x%08" PRIX32, (UINT32)hr);
		return 0;
	}

	hr = pAttributes->lpVtbl->SetGUID(pAttributes, &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE,
	                                   &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_VIDCAP_GUID);
	if (FAILED(hr))
	{
		WLog_ERR(TAG, "SetGUID failed: hr=0x%08" PRIX32, (UINT32)hr);
		pAttributes->lpVtbl->Release(pAttributes);
		return 0;
	}

	IMFActivate** devices = nullptr;
	UINT32 deviceCount = 0;
	hr = MFEnumDeviceSources(pAttributes, &devices, &deviceCount);
	pAttributes->lpVtbl->Release(pAttributes);

	if (FAILED(hr))
	{
		WLog_ERR(TAG, "MFEnumDeviceSources failed: hr=0x%08" PRIX32, (UINT32)hr);
		return 0;
	}

	/* Clear previous activates to avoid accumulating duplicates across successive
	 * enumeration calls (e.g. when the enum channel is re-opened after close).
	 * Each activate is released here; new ones are stored below. */
	for (size_t i = 0; i < ArrayList_Count(hal->activates); i++)
	{
		IMFActivate* act = (IMFActivate*)ArrayList_GetItem(hal->activates, i);
		if (act)
			act->lpVtbl->Release(act);
	}
	ArrayList_Clear(hal->activates);

	/* Store fresh activates for later use */
	for (UINT32 i = 0; i < deviceCount; i++)
	{
		if (!ArrayList_Append(hal->activates, devices[i]))
		{
			WLog_WARN(TAG, "Failed to store IMFActivate[%u]", i);
			devices[i]->lpVtbl->Release(devices[i]);
		}
	}
	CoTaskMemFree(devices);

	/* Enumerate and report to callback */
	const size_t activateCount = ArrayList_Count(hal->activates);
	WLog_DBG(TAG, "Enumerated %u devices from MF, %zu activates stored", deviceCount, activateCount);
	for (size_t idx = 0; idx < activateCount; idx++)
	{
		IMFActivate* activate = (IMFActivate*)ArrayList_GetItem(hal->activates, idx);
		if (!activate)
			continue;

		WCHAR* wszSymbolicLink = nullptr;
		UINT32 slLen = 0;
		hr = activate->lpVtbl->GetAllocatedString(activate,
		          &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_VIDCAP_SYMBOLIC_LINK,
		          &wszSymbolicLink, &slLen);
		if (FAILED(hr))
			continue;

		/* Convert wide char deviceId to UTF-8 */
		int utf8Len = WideCharToMultiByte(CP_UTF8, 0, wszSymbolicLink, -1, nullptr, 0, nullptr, nullptr);
		char* deviceId = (char*)calloc(1, (size_t)utf8Len + 1);
		if (deviceId)
			WideCharToMultiByte(CP_UTF8, 0, wszSymbolicLink, -1, deviceId, utf8Len, nullptr, nullptr);
		CoTaskMemFree(wszSymbolicLink);

		if (!deviceId)
			continue;

		WCHAR* wszFriendlyName = nullptr;
		UINT32 fnLen = 0;
		char* deviceName = nullptr;

		hr = activate->lpVtbl->GetAllocatedString(activate,
		          &MF_DEVSOURCE_ATTRIBUTE_FRIENDLY_NAME,
		          &wszFriendlyName, &fnLen);
		if (SUCCEEDED(hr) && wszFriendlyName)
		{
			int nameLen = WideCharToMultiByte(CP_UTF8, 0, wszFriendlyName, -1, nullptr, 0, nullptr, nullptr);
			deviceName = (char*)calloc(1, (size_t)nameLen + 1);
			if (deviceName)
				WideCharToMultiByte(CP_UTF8, 0, wszFriendlyName, -1, deviceName, nameLen, nullptr, nullptr);
			CoTaskMemFree(wszFriendlyName);
		}

		if (!deviceName)
			deviceName = _strdup(deviceId);

		WLog_INFO(TAG, "Found camera: %s (id=%s)", deviceName, deviceId);

		IFCALL(callback, ecam, hchannel, deviceId, deviceName);
		count++;

		free(deviceName);
		free(deviceId);
	}

	return count;
}

static BOOL cam_wmf_activate(ICamHal* ihal, const char* deviceId, CAM_ERROR_CODE* errorCode)
{
	WINPR_UNUSED(ihal);
	WINPR_UNUSED(deviceId);

	*errorCode = CAM_ERROR_CODE_None;
	return TRUE;
}

static BOOL cam_wmf_deactivate(ICamHal* ihal, const char* deviceId, CAM_ERROR_CODE* errorCode)
{
	/* Like the V4L2 backend, Deactivate is a no-op.
	 * The Media Foundation SourceReader and MediaSource are created once
	 * during the first GetMediaTypeDescriptions and stay alive for the
	 * entire RDP session. Releasing them on every deactivate causes
	 * repeated ActivateObject / Shutdown cycles that exhaust the camera
	 * hardware (MFCreateSourceReaderFromMediaSource → 0xC00D3E85). */
	WINPR_UNUSED(ihal);
	WINPR_UNUSED(deviceId);

	*errorCode = CAM_ERROR_CODE_None;
	return TRUE;
}

/* Re-enumerate devices to refresh the activation store and find a specific device.
 * Called when the device is not found in the cached activation store (e.g. after
 * the enumeration channel closed and the store entries became stale). */
static IMFActivate* cam_wmf_refresh_activate_for_device(CamWmfHal* hal, const char* deviceId)
{
	IMFAttributes* pAttributes = nullptr;
	HRESULT hr = MFCreateAttributes(&pAttributes, 1);
	if (FAILED(hr))
		return nullptr;

	hr = pAttributes->lpVtbl->SetGUID(pAttributes, &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE,
	                                   &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_VIDCAP_GUID);
	if (FAILED(hr))
	{
		pAttributes->lpVtbl->Release(pAttributes);
		return nullptr;
	}

	IMFActivate** devices = nullptr;
	UINT32 deviceCount = 0;
	hr = MFEnumDeviceSources(pAttributes, &devices, &deviceCount);
	pAttributes->lpVtbl->Release(pAttributes);

	if (FAILED(hr) || deviceCount == 0)
	{
		if (devices)
			CoTaskMemFree(devices);
		return nullptr;
	}

	IMFActivate* found = nullptr;
	for (UINT32 i = 0; i < deviceCount; i++)
	{
		/* Store newly enumerated activates — they may be needed later */
		BOOL alreadyStored = FALSE;
		for (size_t j = 0; j < ArrayList_Count(hal->activates); j++)
		{
			if (ArrayList_GetItem(hal->activates, j) == devices[i])
			{
				alreadyStored = TRUE;
				break;
			}
		}
		if (!alreadyStored)
		{
			if (!ArrayList_Append(hal->activates, devices[i]))
			{
				devices[i]->lpVtbl->Release(devices[i]);
				continue;
			}
		}

		/* Check if this device matches */
		WCHAR* wszLink = nullptr;
		UINT32 len = 0;
		hr = devices[i]->lpVtbl->GetAllocatedString(devices[i],
		        &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_VIDCAP_SYMBOLIC_LINK,
		        &wszLink, &len);
		if (FAILED(hr))
			continue;

		int utf8Len = WideCharToMultiByte(CP_UTF8, 0, wszLink, -1, nullptr, 0, nullptr, nullptr);
		char* symLink = (char*)calloc(1, (size_t)utf8Len + 1);
		if (symLink)
			WideCharToMultiByte(CP_UTF8, 0, wszLink, -1, symLink, utf8Len, nullptr, nullptr);
		CoTaskMemFree(wszLink);

		BOOL match = (symLink && strcmp(symLink, deviceId) == 0);
		free(symLink);
		if (match)
		{
			found = devices[i];
			break;
		}
	}

	CoTaskMemFree(devices);
	return found;
}

/* Helper: find the cached IMFActivate for a device by its symbolic link ID. */
static IMFActivate* cam_wmf_find_activate(CamWmfHal* hal, const char* deviceId)
{
	for (size_t i = 0; i < ArrayList_Count(hal->activates); i++)
	{
		IMFActivate* act = (IMFActivate*)ArrayList_GetItem(hal->activates, i);
		if (!act)
			continue;

		WCHAR* wszLink = nullptr;
		UINT32 len = 0;
		HRESULT hr = act->lpVtbl->GetAllocatedString(act,
		              &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_VIDCAP_SYMBOLIC_LINK,
		              &wszLink, &len);
		if (FAILED(hr))
			continue;

		int utf8Len = WideCharToMultiByte(CP_UTF8, 0, wszLink, -1, nullptr, 0, nullptr, nullptr);
		char* symLink = (char*)calloc(1, (size_t)utf8Len + 1);
		if (symLink)
			WideCharToMultiByte(CP_UTF8, 0, wszLink, -1, symLink, utf8Len, nullptr, nullptr);
		CoTaskMemFree(wszLink);

		BOOL match = (symLink && strcmp(symLink, deviceId) == 0);
		free(symLink);

		if (match)
			return act;
	}
	return nullptr;
}

/* Helper: activate an IMFActivate and create a SourceReader.
 * Returns the SourceReader on success (caller must Release it),
 * and sets *outMediaSource (caller must Shutdown + Release).
 * Returns nullptr on failure. */
static IMFSourceReader* cam_wmf_open_device(CamWmfHal* hal, const char* deviceId,
                                            IMFMediaSource** outMediaSource)
{
	*outMediaSource = nullptr;

	IMFActivate* activate = cam_wmf_find_activate(hal, deviceId);
	if (!activate)
	{
		activate = cam_wmf_refresh_activate_for_device(hal, deviceId);
		if (!activate)
		{
			WLog_ERR(TAG, "Device %s not found", deviceId);
			return nullptr;
		}
	}

	IMFMediaSource* mediaSource = nullptr;
	HRESULT hr = activate->lpVtbl->ActivateObject(activate, &IID_IMFMediaSource,
	                                               (void**)&mediaSource);
	if (FAILED(hr))
	{
		WLog_ERR(TAG, "ActivateObject for %s failed: hr=0x%08" PRIX32, deviceId, (UINT32)hr);
		return nullptr;
	}

	IMFAttributes* readerAttr = nullptr;
	MFCreateAttributes(&readerAttr, 1);
	if (readerAttr)
		readerAttr->lpVtbl->SetUINT32(readerAttr, &MF_READWRITE_DISABLE_CONVERTERS, FALSE);

	IMFSourceReader* sourceReader = nullptr;
	static const int MAX_RETRIES = 5;
	static const DWORD RETRY_DELAY_MS = 400;

	for (int attempt = 1; attempt <= MAX_RETRIES; attempt++)
	{
		hr = MFCreateSourceReaderFromMediaSource(mediaSource, readerAttr, &sourceReader);
		if (SUCCEEDED(hr))
			break;

		WLog_WARN(TAG,
		    "MFCreateSourceReaderFromMediaSource failed (attempt %d/%d): hr=0x%08" PRIX32,
		    attempt, MAX_RETRIES, (UINT32)hr);

		if (attempt < MAX_RETRIES)
		{
			mediaSource->lpVtbl->Shutdown(mediaSource);
			mediaSource->lpVtbl->Release(mediaSource);
			mediaSource = nullptr;

			Sleep(RETRY_DELAY_MS);

			hr = activate->lpVtbl->ActivateObject(activate, &IID_IMFMediaSource,
			                                       (void**)&mediaSource);
			if (FAILED(hr))
			{
				WLog_ERR(TAG, "ActivateObject retry %d failed: hr=0x%08" PRIX32,
				         attempt, (UINT32)hr);
				break;
			}
		}
	}

	if (readerAttr)
		readerAttr->lpVtbl->Release(readerAttr);

	if (FAILED(hr))
	{
		WLog_ERR(TAG,
		    "MFCreateSourceReaderFromMediaSource failed after all retries: hr=0x%08" PRIX32,
		    (UINT32)hr);
		if (mediaSource)
			mediaSource->lpVtbl->Release(mediaSource);
		return nullptr;
	}

	*outMediaSource = mediaSource;
	return sourceReader;
}

/* Helper: release SourceReader and shutdown/release MediaSource. */
static void cam_wmf_close_device(IMFSourceReader** pSourceReader,
                                 IMFMediaSource** pMediaSource)
{
	if (pSourceReader && *pSourceReader)
	{
		(*pSourceReader)->lpVtbl->Release(*pSourceReader);
		*pSourceReader = nullptr;
	}
	if (pMediaSource && *pMediaSource)
	{
		(*pMediaSource)->lpVtbl->Shutdown(*pMediaSource);
		(*pMediaSource)->lpVtbl->Release(*pMediaSource);
		*pMediaSource = nullptr;
	}
}

static INT16 cam_wmf_get_media_type_descriptions(
    ICamHal* ihal, const char* deviceId, size_t streamIndex,
    const CAM_MEDIA_FORMAT_INFO* supportedFormats, size_t nSupportedFormats,
    CAM_MEDIA_TYPE_DESCRIPTION* mediaTypes, size_t* nMediaTypes)
{
	CamWmfHal* hal = (CamWmfHal*)ihal;
	size_t maxMediaTypes = *nMediaTypes;
	size_t nTypes = 0;
	INT16 matchedFormatIndex = -1;

	/* Track whether stream was newly inserted so we can remove it on failure. */
	BOOL streamCreatedHere = FALSE;
	CamWmfStream* stream = (CamWmfStream*)HashTable_GetItemValue(hal->streams, deviceId);

	if (!stream)
	{
		stream = cam_wmf_stream_create(deviceId, streamIndex);
		if (!stream)
			return -1;

		if (!HashTable_Insert(hal->streams, deviceId, stream))
		{
			cam_wmf_stream_free(stream);
			return -1;
		}
		streamCreatedHere = TRUE;
	}

	/* Like the V4L2 backend: create the SourceReader once and reuse it
	 * for the entire CameraDevice lifetime. It is only released in
	 * cam_wmf_stream_free() when the RDP session ends. */
	if (stream->sourceReader)
	{
		WLog_DBG(TAG, "Reusing existing source reader for device %s", deviceId);
		goto enumerate_types;
	}

	{
		IMFMediaSource* mediaSource = nullptr;
		IMFSourceReader* sourceReader =
		    cam_wmf_open_device(hal, deviceId, &mediaSource);
		if (!sourceReader)
		{
			if (streamCreatedHere)
				HashTable_Remove(hal->streams, deviceId);
			return -1;
		}

		stream->sourceReader = sourceReader;
		stream->mediaSource = mediaSource;
	}

enumerate_types:
	/* Enumerate native media types */
	for (size_t fi = 0; fi < nSupportedFormats && fi <= INT16_MAX; fi++)
	{
		const GUID* targetSubtype = ecamToMfSubtype(supportedFormats[fi].inputFormat);
		if (!targetSubtype)
			continue;

		DWORD typeIndex = 0;
		BOOL formatFound = FALSE;
		HRESULT hr;

		while (TRUE)
		{
			IMFMediaType* mt = nullptr;
			hr = stream->sourceReader->lpVtbl->GetNativeMediaType(stream->sourceReader,
			         MF_SOURCE_READER_FIRST_VIDEO_STREAM, typeIndex, &mt);
			if (hr == MF_E_NO_MORE_TYPES)
				break;

			if (FAILED(hr))
			{
				typeIndex++;
				continue;
			}

			GUID subtype = GUID_NULL;
			UINT32 hr2 = mt->lpVtbl->GetGUID(mt, &s_cam_MF_MT_SUBTYPE, &subtype);

			UINT32 width = 0, height = 0;
			UINT32 fpsNum = CAM_WMF_FRAMERATE_NUMERATOR_DEFAULT;
			UINT32 fpsDen = CAM_WMF_FRAMERATE_DENOMINATOR_DEFAULT;

			if (SUCCEEDED(hr2))
			{
				UINT64 frameSize = 0;
				if (SUCCEEDED(mt->lpVtbl->GetUINT64(mt, &s_cam_MF_MT_FRAME_SIZE, &frameSize)))
				{
					width = (UINT32)(frameSize >> 32);
					height = (UINT32)frameSize;
				}

				UINT64 frameRate = 0;
				if (SUCCEEDED(mt->lpVtbl->GetUINT64(mt, &s_cam_MF_MT_FRAME_RATE, &frameRate)))
				{
					fpsNum = (UINT32)(frameRate >> 32);
					fpsDen = (UINT32)frameRate;
				}
			}

			if (SUCCEEDED(hr2) && memcmp(&subtype, targetSubtype, sizeof(GUID)) == 0)
			{
				/* Save the first matching native IMFMediaType for
				 * SetCurrentMediaType in cam_wmf_stream_start.
				 * Using the driver's original type object preserves
				 * any extra attributes required by the camera. */
				if (!formatFound && !stream->nativeMediaType)
					stream->nativeMediaType = mt;
				else
					mt->lpVtbl->Release(mt);

				formatFound = TRUE;
				if (nTypes < maxMediaTypes)
				{
					mediaTypes[nTypes].Format = supportedFormats[fi].inputFormat;
					mediaTypes[nTypes].Width = width;
					mediaTypes[nTypes].Height = height;
					mediaTypes[nTypes].FrameRateNumerator = fpsNum;
					mediaTypes[nTypes].FrameRateDenominator = fpsDen;
					mediaTypes[nTypes].PixelAspectRatioNumerator = 1;
					mediaTypes[nTypes].PixelAspectRatioDenominator = 1;
					mediaTypes[nTypes].Flags = 0;

					WLog_DBG(TAG, "Camera format: idx=%u, %ux%u, fps=%u/%u", (UINT)typeIndex,
					         width, height, fpsNum, fpsDen);

					nTypes++;
				}
			}
			else
			{
				mt->lpVtbl->Release(mt);
			}
			typeIndex++;
		}

		if (formatFound && matchedFormatIndex < 0)
			matchedFormatIndex = (INT16)fi;
	}

	*nMediaTypes = nTypes;

	/* Like the V4L2 backend, keep the SourceReader alive after enumeration.
	 * It was created once and will be reused for StreamStart.
	 * Only cam_wmf_stream_free() releases it at session end. */
	return matchedFormatIndex >= 0 ? matchedFormatIndex : 0;
}

static CAM_ERROR_CODE cam_wmf_stream_start(ICamHal* ihal, CameraDevice* dev, size_t streamIndex,
                                           const CAM_MEDIA_TYPE_DESCRIPTION* mediaType,
                                           ICamHalSampleCapturedCallback callback)
{
	CamWmfHal* hal = (CamWmfHal*)ihal;
	WINPR_ASSERT(hal);

	CamWmfStream* stream = (CamWmfStream*)HashTable_GetItemValue(hal->streams, dev->deviceId);

	if (!stream)
	{
		WLog_ERR(TAG, "Unable to find stream for device %s", dev->deviceId);
		return CAM_ERROR_CODE_UnexpectedError;
	}

	if (stream->streaming)
	{
		WLog_ERR(TAG, "Streaming already in progress for device %s", dev->deviceId);
		return CAM_ERROR_CODE_UnexpectedError;
	}

	/* Like the V4L2 backend, reuse the SourceReader that was created during
	 * the first GetMediaTypeDescriptions. It stays alive until the RDP
	 * session ends (released by cam_wmf_stream_free). */
	if (!stream->sourceReader)
	{
		WLog_ERR(TAG, "No source reader for device %s — GetMediaTypeDescriptions must be called first",
		         dev->deviceId);
		return CAM_ERROR_CODE_NotInitialized;
	}

	stream->dev = dev;
	stream->sampleCallback = callback;

	/* For H.264 output, the MF encoder MFT requires NV12 input.
	 * The SourceReader can convert from YUY2 to NV12 when converters
	 * are enabled (MF_READWRITE_DISABLE_CONVERTERS=FALSE). */
	IMFMediaType* pSetType = stream->nativeMediaType;
	IMFMediaType* pNv12Type = nullptr;
	BOOL needReleaseType = FALSE;

	if (streamOutputFormat(&dev->streams[0]) == CAM_MEDIA_FORMAT_H264)
	{
		HRESULT hrType = MFCreateMediaType(&pNv12Type);
		if (SUCCEEDED(hrType))
		{
			pNv12Type->lpVtbl->SetGUID(pNv12Type, &MF_MT_MAJOR_TYPE,
			                            &MFMediaType_Video);
			pNv12Type->lpVtbl->SetGUID(pNv12Type, &MF_MT_SUBTYPE,
			                            &MFVideoFormat_NV12);
			pSetType = pNv12Type;
			needReleaseType = TRUE;
		}
	}

	if (!pSetType)
	{
		WLog_ERR(TAG, "No media type for device %s", dev->deviceId);
		return CAM_ERROR_CODE_NotInitialized;
	}

	HRESULT hr = stream->sourceReader->lpVtbl->SetCurrentMediaType(
	    stream->sourceReader, MF_SOURCE_READER_FIRST_VIDEO_STREAM, NULL, pSetType);

	if (needReleaseType)
		pNv12Type->lpVtbl->Release(pNv12Type);

	if (FAILED(hr))
	{
		WLog_ERR(TAG, "SetCurrentMediaType failed: hr=0x%08" PRIX32, (UINT32)hr);
		return CAM_ERROR_CODE_InvalidMediaType;
	}

	stream->streaming = TRUE;

	stream->captureThread = CreateThread(nullptr, 0, cam_wmf_capture_thread, stream, 0, nullptr);
	if (!stream->captureThread)
	{
		WLog_ERR(TAG, "CreateThread failed");
		stream->streaming = FALSE;
		return CAM_ERROR_CODE_OutOfMemory;
	}

	WLog_INFO(TAG, "Camera streaming started: %s, %ux%u, %u/%u fps", dev->deviceId,
	          mediaType->Width, mediaType->Height, mediaType->FrameRateNumerator,
	          mediaType->FrameRateDenominator);

	return CAM_ERROR_CODE_None;
}

static CAM_ERROR_CODE cam_wmf_stream_stop_by_device_id(ICamHal* ihal, const char* deviceId,
                                                       WINPR_ATTR_UNUSED size_t streamIndex)
{
	CamWmfHal* hal = (CamWmfHal*)ihal;

	CamWmfStream* stream = (CamWmfStream*)HashTable_GetItemValue(hal->streams, deviceId);

	if (!stream)
		return CAM_ERROR_CODE_NotInitialized;

	return cam_wmf_stream_stop(stream);
}

CAM_ERROR_CODE cam_wmf_stream_stop(CamWmfStream* stream)
{
	if (!stream || !stream->streaming)
		return CAM_ERROR_CODE_None;

	WLog_INFO(TAG, "Stopping camera stream...");

	stream->streaming = FALSE;

	/* Clear callback pointers so capture thread won't try to deliver
	 * samples to a freed CameraDevice after we return. */
	stream->dev = nullptr;
	stream->sampleCallback = nullptr;

	/* Flush to unblock ReadSample */
	if (stream->sourceReader)
	{
		stream->sourceReader->lpVtbl->Flush(stream->sourceReader, MF_SOURCE_READER_FIRST_VIDEO_STREAM);
	}

	/* Wait for capture thread to exit */
	if (stream->captureThread)
	{
		WaitForSingleObject(stream->captureThread, 5000);
		CloseHandle(stream->captureThread);
		stream->captureThread = nullptr;
	}

	/* Like the V4L2 backend, keep the SourceReader and MediaSource alive
	 * after stopping the stream. They were created once during the first
	 * GetMediaTypeDescriptions and will be reused for the next StreamStart.
	 * Only cam_wmf_stream_free() releases them at session end. */

	WLog_INFO(TAG, "Camera stream stopped");
	return CAM_ERROR_CODE_None;
}

static CAM_ERROR_CODE cam_wmf_free(ICamHal* ihal)
{
	CamWmfHal* hal = (CamWmfHal*)ihal;

	if (hal == nullptr)
		return CAM_ERROR_CODE_NotInitialized;

	HashTable_Free(hal->streams);
	hal->streams = nullptr;

	/* Release all IMFActivate* objects */
	if (hal->activates)
	{
		for (size_t i = 0; i < ArrayList_Count(hal->activates); i++)
		{
			IMFActivate* act = (IMFActivate*)ArrayList_GetItem(hal->activates, i);
			if (act)
				act->lpVtbl->Release(act);
		}
		ArrayList_Free(hal->activates);
		hal->activates = nullptr;
	}

	free(hal);

	cam_wmf_global_shutdown();
	return CAM_ERROR_CODE_None;
}

/**
 * Subsystem entry point — called by FreeRDP addin manager
 */
FREERDP_ENTRY_POINT(UINT VCAPITYPE wmf_freerdp_rdpecam_client_subsystem_entry(
    PFREERDP_CAMERA_HAL_ENTRY_POINTS pEntryPoints))
{
	UINT ret = ERROR_INTERNAL_ERROR;
	HRESULT hr;

	WINPR_ASSERT(pEntryPoints);

	hr = cam_wmf_global_init();
	if (FAILED(hr))
		return CHANNEL_RC_INITIALIZATION_ERROR;

	CamWmfHal* hal = (CamWmfHal*)calloc(1, sizeof(CamWmfHal));
	if (!hal)
	{
		cam_wmf_global_shutdown();
		return CHANNEL_RC_NO_MEMORY;
	}

	hal->iHal.Enumerate = cam_wmf_enumerate;
	hal->iHal.GetMediaTypeDescriptions = cam_wmf_get_media_type_descriptions;
	hal->iHal.Activate = cam_wmf_activate;
	hal->iHal.Deactivate = cam_wmf_deactivate;
	hal->iHal.StartStream = cam_wmf_stream_start;
	hal->iHal.StopStream = cam_wmf_stream_stop_by_device_id;
	hal->iHal.Free = cam_wmf_free;

	hal->streams = HashTable_New(FALSE);
	if (!hal->streams)
		goto error;

	if (!HashTable_SetupForStringData(hal->streams, FALSE))
		goto error;

	wObject* obj = HashTable_ValueObject(hal->streams);
	WINPR_ASSERT(obj);
	obj->fnObjectFree = cam_wmf_stream_free;

	hal->activates = ArrayList_New(FALSE);
	if (!hal->activates)
		goto error;

	ret = pEntryPoints->pRegisterCameraHal(pEntryPoints->plugin, &hal->iHal);
	if (ret != CHANNEL_RC_OK)
	{
		WLog_ERR(TAG, "RegisterCameraHal failed with error %" PRIu32 "", ret);
		goto error;
	}

	return ret;

error:
	cam_wmf_free(&hal->iHal);
	return ret;
}
